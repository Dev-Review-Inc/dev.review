<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Source of truth for the iOS app's entitlements. Xcode does not read this
  file directly.

  `cargo tauri ios init` writes a blank entitlements file for each target in
  gen/apple/. That directory is gitignored and init rebuilds it, so nothing
  placed only there survives. Run ./ios-prepare.sh instead of a bare init.
  It runs init, copies this file and the widget's to the paths that the
  generated project names, and fails if either copy lacks the App Group.

  iCloud.review.dev.app and group.review.dev.app were registered against this
  project's own Apple Developer team through Xcode's own Signing &
  Capabilities UI - that step talks to Apple's developer portal and isn't
  something to hand-author here blind. This file is what was captured from
  what Xcode wrote there.
-->
<plist version="1.0">
<dict>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>iCloud.review.dev.app</string>
  </array>
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudDocuments</string>
  </array>
  <key>com.apple.developer.ubiquity-container-identifiers</key>
  <array>
    <string>iCloud.review.dev.app</string>
  </array>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.review.dev.app</string>
  </array>
</dict>
</plist>
