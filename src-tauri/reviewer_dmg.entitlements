<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID .dmg. It is not sandboxed, but it runs
  under the hardened runtime, which blocks the microphone without this key.
  The microphone is how the reader talks to the agent (web/src/app/voice.js).
  The App Store bundle uses reviewer_macOS.entitlements instead.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
