#!/bin/sh
# Checks that must pass before a commit lands.
#
# Tracked, and pointed at by core.hooksPath, rather than living in .git/hooks:
# hooks in .git are local to one clone, are not carried by a bundle or a push,
# and are lost with the directory. This repository lost its originals exactly
# that way. Tracked, they survive a reboot and a contributor gets them too.
#
# Enable with:  git config core.hooksPath .githooks
#
# Each check runs only when the commit touches files it applies to, so a commit
# that changes prose does not wait for the Go suite.
#
# The node linters run through `npx -y` rather than a local binary, because this
# project has no dependencies to install one into. They fail the commit rather
# than skipping when unavailable: a check that quietly does nothing is worse
# than no check, because it reads as a passing one.
#
# Their versions are pinned. Unpinned, npx takes the latest, and a release that
# adds a rule blocks commits on files nobody touched - which is exactly how a
# table in the README that had been fine for months suddenly stopped the build.

set -e

changed=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$changed" ] && exit 0

has() { echo "$changed" | grep -qE "$1"; }
step() { printf '\n%s:\n' "$1"; }
ok() { printf '  OK.\n'; }

echo "Changed files:"
echo "$changed" | sed 's/^/  - /'

if has '\.js$|\.mjs$'; then
  step "ESLint"
  npx -y eslint@9 $(echo "$changed" | grep -E '\.m?js$' | tr '\n' ' ')
  ok

  step "JS specs"
  npm run --silent test:units
  ok
fi

if has '^serve/.*\.go$'; then
  step "gofmt"
  unformatted=$(gofmt -l serve/)
  if [ -n "$unformatted" ]; then
    printf '  not formatted:\n%s\n' "$unformatted"
    exit 1
  fi
  ok

  step "go vet"
  (cd serve && go vet ./...)
  ok

  step "Go tests"
  (cd serve && go test ./...)
  ok
fi

if has '\.md$'; then
  step "markdownlint"
  npx -y markdownlint-cli@0.45 $(echo "$changed" | grep -E '\.md$' | tr '\n' ' ')
  ok
fi

printf '\nGit hooks: passed.\n'
